{
  "name": "internamaro-apify-data-mcp",
  "version": "0.1.0",
  "description": "MCP server for data post-processing on Apify: HTML to Markdown, bulk HTTP requests, flatten JSON, filter rows, remove duplicates, Excel to JSON and domain availability. Runs on your own Apify account.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "internamaro-apify-data-mcp": "dist/src/index.js"
  },
  "main": "dist/src/server.js",
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "apify",
    "html-to-markdown",
    "json",
    "csv",
    "excel",
    "deduplicate",
    "domain-availability"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/internamaro/internamaro-apify-data-mcp.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "5.9.3"
  }
}
